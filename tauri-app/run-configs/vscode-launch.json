{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Tauri",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["tauri", "dev"],
        "filter": {
          "name": "lol-clip-tool",
          "kind": "bin"
        }
      },
      "cwd": "${workspaceFolder}",
      "env": {
        "RUST_LOG": "debug"
      }
    }
  ]
}
